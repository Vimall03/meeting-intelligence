# Allow only runtime code and locked dependency metadata into the build.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!run_server.py
!healthcheck.py
!app/
!app/**/*.py
app/**/__pycache__/
**/.env*
**/.data/

# Recap generation runs in its own worker package, not the meeting server.
app/mom/worker.py
app/mom/processing.py
app/mom/email_template.py
