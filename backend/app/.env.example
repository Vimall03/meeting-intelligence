OPENROUTER_API_KEY=

# Google Drive backend OAuth. Create a Google OAuth Web application client and
# add GOOGLE_DRIVE_REDIRECT_URI to its authorized redirect URIs.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/integrations/google-drive/oauth/callback
# Optional; if empty, the client secret is used to sign OAuth state.
GOOGLE_DRIVE_OAUTH_STATE_SECRET=
GOOGLE_DRIVE_TOKEN_PATH=.data/google_drive_token.json
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# Atlassian Cloud OAuth 2.0 (3LO). Enable Jira read:jira-work and
# write:jira-work; optionally enable Confluence search:confluence.
# Register the exact redirect URI below in the same developer app.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_SITE_URL=
ATLASSIAN_REDIRECT_URI=http://localhost:8000/api/integrations/atlassian/oauth/callback
# Optional; defaults to the client secret for signed OAuth state.
ATLASSIAN_OAUTH_STATE_SECRET=
ATLASSIAN_TOKEN_PATH=.data/atlassian_token.json

# Continuous transcription uses the server role in AWS_REGION.
# Uses the server AWS role (transcribe:StartStreamTranscription). Never put AWS keys in the extension.
STREAMING_STT_LANGUAGE=en-US
