HUGGING_FACE_AUTH_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=openai/gpt-transcribe
OPENROUTER_STT_URL=https://openrouter.ai/api/v1/audio/transcriptions

# Google Drive backend OAuth. Create a Google OAuth Web application client and
# add GOOGLE_DRIVE_REDIRECT_URI to its authorized redirect URIs.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/integrations/google-drive/oauth/callback
# Optional; if empty, the client secret is used to sign OAuth state.
GOOGLE_DRIVE_OAUTH_STATE_SECRET=
GOOGLE_DRIVE_TOKEN_PATH=.data/google_drive_token.json
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly
