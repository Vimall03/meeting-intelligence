# Runtime only: copy to .env.production and fill deployment outputs/secrets.
# Do not build credentials into the image. EC2 uses its IAM instance role.
AWS_REGION=us-east-1
AUTH_USER_POOL_ID=
AUTH_CLIENT_ID=
AUTH_TABLE_NAME=
INTEGRATION_KEY_ID=
EXTENSION_ORIGIN=

OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=openai/gpt-transcribe
JEV_MODEL=typesafe/jev-1.13
GEMMA_MODEL=google/gemma-4-26b-a4b-it

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Exact public HTTPS callback; domain is configured in the hosting step.
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=
