# Copy into backend/app/.env along with the existing provider/meeting settings.
# No deployment has been performed; obtain values from future CDK outputs.
AWS_REGION=us-east-1
AUTH_USER_POOL_ID=
AUTH_CLIENT_ID=
AUTH_TABLE_NAME=
INTEGRATION_KEY_ID=
EXTENSION_ORIGIN=
# Attach BackendUserDataPolicyArn to the backend runtime IAM role.
# Keep GOOGLE_DRIVE_CLIENT_SECRET and ATLASSIAN_CLIENT_SECRET server-side.
# Register exact HTTPS callback addresses in both provider consoles.
GOOGLE_DRIVE_REDIRECT_URI=
ATLASSIAN_REDIRECT_URI=
